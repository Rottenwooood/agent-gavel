{
  "app": "wechat",
  "desc": "删除文件传输助手中的一条消息。动态定位: 读树找 $MSG 的 list item bounds, 在行右缘内偏移右键气泡(微信消息靠右); 菜单/确认框语义点击。不依赖写死坐标。",
  "app_id": "wechat.desktop",
  "steps": [
    {
      "action": "activate_window",
      "action_args": {},
      "timeout_s": 5.0
    },
    {
      "action": "move_window",
      "action_args": {"x": 0, "y": 32},
      "timeout_s": 5.0
    },
    {
      "action": "click",
      "locate": {"role": "list item", "name": "$MSG", "right_pad": 150},
      "action_args": {"button": "right"},
      "timeout_s": 6.0
    },
    {
      "action": "click",
      "action_args": {"role": "menu item", "name": "删除"},
      "timeout_s": 6.0
    },
    {
      "action": "click",
      "action_args": {"role": "push button", "name": "删除"},
      "assertions": [
        {
          "type": "element_disappears",
          "role": "list item",
          "name": "$MSG"
        }
      ],
      "timeout_s": 8.0
    }
  ]
}
