{
  "site": "baike",
  "desc": "百度百科查词条：直接导航 /item/词条 直达页（首页搜索框非标准input难定位，URL直达更稳更快），断言 title 含词条名（不存在则 title 是通用页，断言自然失败）",
  "home": "https://baike.baidu.com/",
  "steps": [
    {
      "action": "navigate",
      "selectors": {
        "url": "https://baike.baidu.com/item/$QUERY"
      },
      "page_features": {
        "t": "document.title",
        "url": "location.href"
      },
      "expected_feature": {
        "t": {
          "op": "contains",
          "value": "$QUERY"
        }
      }
    }
  ],
  "saved_at": "2026-09-09T00:00:00",
  "params": [
    "QUERY"
  ]
}