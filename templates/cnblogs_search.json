{
  "site": "cnblogs-search",
  "desc": "博客园站内搜索(找找看 zzkx)：导航首页→顶部导航搜索框(注意 id 重复,需用 #zzk_search input[name=w] 定位可见框)→填关键词→回车提交→断言跳转结果页 URL 含 w=关键词。注意:搜索可能触发滑块人机验证(反爬),非工具问题。",
  "home": "https://www.cnblogs.com/",
  "steps": [
    {
      "action": "navigate",
      "selectors": {
        "url": "https://www.cnblogs.com/"
      },
      "page_features": {
        "t": "document.title"
      },
      "expected_feature": {
        "t": {
          "op": "contains",
          "value": "博客园"
        }
      }
    },
    {
      "action": "set_value",
      "selectors": {
        "input": "#zzk_search input[name='w']",
        "value": "$QUERY"
      },
      "page_features": {
        "v": "(document.querySelector('#zzk_search input[name=w]')||{}).value||''"
      },
      "expected_feature": {
        "v": {
          "op": "eq",
          "value": "$QUERY"
        }
      }
    },
    {
      "action": "press_enter",
      "page_features": {
        "u": "decodeURIComponent(location.href)"
      },
      "expected_feature": {
        "u": {
          "op": "contains",
          "value": "w=$QUERY"
        }
      }
    }
  ],
  "saved_at": "2026-09-08T02:44:35"
}