 async fn connect() -> Result<AccessibilityConnection> {
     hydrate_session_bus_env();
-    AccessibilityConnection::new()
+
+    // 跨调用复用同一个 AT-SPI 连接：zbus 的 AccessibilityConnection 是
+    // Arc 句柄(Clone 零成本)，重复 new() 每次都要重建 session bus 连接 +
+    // a11y bus 连接 + 代理，固定 ~300ms。首次真正连接后缓存，后续 clone。
+    static CONN_CACHE: std::sync::OnceLock<std::sync::Mutex<Option<AccessibilityConnection>>> =
+        std::sync::OnceLock::new();
+    let cache = CONN_CACHE.get_or_init(|| std::sync::Mutex::new(None));
+
+    // 快速路径：已有缓存连接，clone 返回（零成本 Arc 复制）
+    if let Some(conn) = cache.lock().unwrap().as_ref() {
+        return Ok(conn.clone());
+    }
+
+
+    // 慢路径：首次真正建立连接（放锁外，避免长时间持锁阻塞其他协程）
+    let new_conn = AccessibilityConnection::new()
         .await
-        .context("failed to connect to AT-SPI bus")
+        .context("failed to connect to AT-SPI bus")?;
+    let mut guard = cache.lock().unwrap();
+    if guard.is_none() {
+        *guard = Some(new_conn.clone());
+    }
+    Ok(new_conn)
 }
 
