{
  "site": "google",
  "desc": "Google 搜索任意关键词并确认结果页",
  "home": "https://www.google.com",
  "steps": [
    {
      "action": "navigate",
      "selectors": {
        "url": "https://www.google.com"
      },
      "page_features": {
        "title": "document.title"
      },
      "expected_feature": {
        "title": {
          "op": "exists"
        }
      }
    },
    {
      "action": "set_value",
      "selectors": {
        "input": "textarea[name='q'], input[name='q']",
        "value": "$QUERY"
      },
      "page_features": {
        "input_value": "(document.querySelector('textarea[name=q], input[name=q]')||{}).value||''"
      },
      "expected_feature": {
        "input_value": {
          "op": "eq",
          "value": "$QUERY"
        }
      }
    },
    {
      "action": "click",
      "selectors": {
        "target": "input[name='btnK'], button[aria-label*='Google 搜索'], button[aria-label*='Google Search']"
      },
      "page_features": {
        "title": "document.title",
        "url": "location.href",
        "has_result": "!!document.querySelector('#search, #rso')"
      },
      "expected_feature": {
        "has_result": {
          "op": "exists"
        }
      }
    }
  ],
  "saved_at": "2026-09-07T23:06:23",
  "params": [
    "QUERY"
  ]
}