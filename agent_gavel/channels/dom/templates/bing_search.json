      "page_features": {
        "title": "document.title",
        "url": "location.href"
      },
      "expected_feature": {
        "title": {
          "op": "contains",
          "value": "必应"
        }
      }
    },
    {
      "action": "set_value",
      "selectors": {
        "input": "#sb_form_q",
        "value": "$QUERY"
      },
      "page_features": {
        "input_value": "document.querySelector('#sb_form_q').value"
      },
      "expected_feature": {
        "input_value": {
          "op": "eq",
          "value": "$QUERY"
        }
      }
    },
    {
      "action": "press_enter",
      "selectors": {
        "target": "#sb_form_q"
      },
      "page_features": {
        "page_title": "document.title",
        "page_url": "location.href"
      },
      "expected_feature": {
        "page_title": {
          "op": "contains",
          "value": "$QUERY"
        }
      }
    }
  ],
