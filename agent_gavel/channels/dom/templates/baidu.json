{
  "site": "baidu",
  "desc": "百度搜索任意关键词并确认结果页",
  "home": "https://www.baidu.com",
  "steps": [
    {
      "action": "navigate",
      "selectors": {
        "url": "https://www.baidu.com"
      },
      "page_features": {
        "title": "document.title"
      },
      "expected_feature": {
        "title": {
          "op": "exists"
        }
      }
    },
    {
      "action": "set_value",
      "selectors": {
        "input": "#kw",
        "value": "$QUERY"
      },
      "page_features": {
        "input_value": "(document.querySelector('#kw')||{}).value||''"
      },
      "expected_feature": {
        "input_value": {
          "op": "eq",
          "value": "$QUERY"
        }
      }
    },
    {
      "action": "press_enter",
      "page_features": {
        "title": "document.title",
        "url": "location.href"
      },
      "expected_feature": {
        "url": {
          "op": "contains",
          "value": "wd="
        }
      }
    }
  ],
  "saved_at": "2026-09-07T23:06:23"
}